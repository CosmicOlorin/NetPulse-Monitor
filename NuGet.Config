<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- NetPulse has no third-party packages. NuGet supplies Microsoft's
       self-contained Windows runtime packs during release publishing. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
