<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="NetPulse.Companion.App.MainPage" BackgroundColor="#111820" Shell.NavBarIsVisible="False">
  <Grid RowDefinitions="Auto,*" Padding="18,16">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <VerticalStackLayout Spacing="0"><Label Text="NetPulse Monitor" FontSize="28" FontAttributes="Bold" TextColor="#F3F7FA"/><Label Text="End-to-end Internet monitoring with router telemetry" FontSize="12" TextColor="#8FA3B5"/></VerticalStackLayout>
      <Border Grid.Column="1" BackgroundColor="#183D32" Stroke="#2BAA78" StrokeThickness="1" Padding="12,7"><Label x:Name="ConnectionBadge" Text="NOT PAIRED" FontAttributes="Bold" TextColor="#63D9A7"/></Border>
    </Grid>
    <ScrollView Grid.Row="1"><VerticalStackLayout Spacing="14">
      <Border x:Name="PairingPanel" BackgroundColor="#1B2530" Stroke="#354454" Padding="18"><VerticalStackLayout Spacing="12">
        <Label Text="Connect to your PC" FontSize="21" FontAttributes="Bold" TextColor="#F3F7FA"/>
        <Label Text="On the desktop app open Settings → Mobile companion. Scan its QR code or paste the pairing code. Pairing remains valid until you revoke it on the PC." TextColor="#B9C8D4" LineBreakMode="WordWrap"/>
        <Editor x:Name="PairingCodeEntry" Placeholder="netpulse://pair?..." AutoSize="TextChanges" MinimumHeightRequest="86" BackgroundColor="#10171E" TextColor="#F3F7FA" PlaceholderColor="#657789"/>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="Scan QR" Clicked="OnScanQrClicked" BackgroundColor="#25445E" TextColor="White"/><Button Grid.Column="1" Text="Connect" Clicked="OnConnectClicked" BackgroundColor="#16875D" TextColor="White"/></Grid>
        <Label x:Name="PairingErrorLabel" TextColor="#FF8A80" IsVisible="False"/>
      </VerticalStackLayout></Border>
      <VerticalStackLayout x:Name="DashboardPanel" IsVisible="False" Spacing="12">
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
          <Button Text="Dashboard" FontSize="12" Clicked="OnStatusTabClicked" BackgroundColor="#16875D" TextColor="White"/>
          <Button Grid.Column="1" Text="SMS" FontSize="12" Clicked="OnSmsTabClicked" BackgroundColor="#25445E" TextColor="White"/>
          <Button Grid.Column="2" Text="LTE control" FontSize="12" Clicked="OnLteTabClicked" BackgroundColor="#25445E" TextColor="White"/>
          <Button Grid.Column="3" Text="Devices" FontSize="12" Clicked="OnDevicesTabClicked" BackgroundColor="#25445E" TextColor="White"/>
        </Grid>
        <VerticalStackLayout x:Name="StatusContent" Spacing="12">
        <Grid ColumnDefinitions="*,Auto"><Label Text="DASHBOARD" FontAttributes="Bold" TextColor="#5DC8FF"/><Label Grid.Column="1" x:Name="LastUpdateLabel" Text="Waiting for live data…" FontSize="11" TextColor="#8FA3B5"/></Grid>
        <Border BackgroundColor="#1B2530" Stroke="#354454" Padding="14"><VerticalStackLayout Spacing="10">
          <Label Text="CURRENT CONNECTION — THIS PHONE → INTERNET" FontAttributes="Bold" TextColor="#5DC8FF"/>
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
            <VerticalStackLayout><Label Text="INTERNET" FontSize="11" TextColor="#8FA3B5"/><Label x:Name="InternetLabel" Text="—" FontSize="22" FontAttributes="Bold" TextColor="#F3F7FA"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1"><Label Text="PING / JITTER" FontSize="11" TextColor="#8FA3B5"/><Label x:Name="PingLabel" Text="—" FontSize="18" FontAttributes="Bold" TextColor="#F3F7FA"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1"><Label Text="LOSS / AVAILABILITY" FontSize="11" TextColor="#8FA3B5"/><Label x:Name="QualityLabel" Text="—" FontSize="17" FontAttributes="Bold" TextColor="#F3F7FA"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1" Grid.Column="1"><Label Text="OUTAGES / UNREAD SMS" FontSize="11" TextColor="#8FA3B5"/><Label x:Name="EventsLabel" Text="—" FontSize="17" FontAttributes="Bold" TextColor="#F3F7FA"/></VerticalStackLayout>
          </Grid>
        </VerticalStackLayout></Border>
        <Border BackgroundColor="#1B2530" Stroke="#354454" Padding="14"><VerticalStackLayout Spacing="10">
          <Label Text="ROUTER LTE TELEMETRY" FontAttributes="Bold" TextColor="#5DC8FF"/>
          <Label x:Name="RouterLabel" Text="—" FontSize="17" FontAttributes="Bold" TextColor="#F3F7FA" LineBreakMode="WordWrap"/>
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <VerticalStackLayout><Label Text="SERVING PROFILE" FontSize="11" TextColor="#8FA3B5"/><Label x:Name="ProfileLabel" Text="—" FontSize="17" FontAttributes="Bold" TextColor="#F3F7FA" LineBreakMode="WordWrap"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1"><Label Text="RF VALUES" FontSize="11" TextColor="#8FA3B5"/><Label x:Name="SignalLabel" Text="—" FontSize="14" FontAttributes="Bold" TextColor="#F3F7FA" LineBreakMode="WordWrap"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1"><Label Text="EARFCN" FontSize="11" TextColor="#8FA3B5"/><Label x:Name="EarfcnLabel" Text="—" FontSize="17" FontAttributes="Bold" TextColor="#F3F7FA"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1" Grid.Column="1"><Label Text="PCI / CID" FontSize="11" TextColor="#8FA3B5"/><Label x:Name="IdentityLabel" Text="—" FontSize="17" FontAttributes="Bold" TextColor="#F3F7FA"/></VerticalStackLayout>
            <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2"><Label Text="LIVE ROUTER TRAFFIC — UP / DOWN" FontSize="11" TextColor="#8FA3B5"/><Label x:Name="RouterRateLabel" Text="—" FontSize="17" FontAttributes="Bold" TextColor="#F3F7FA"/></VerticalStackLayout>
          </Grid>
        </VerticalStackLayout></Border>
        <Label x:Name="LiveErrorLabel" TextColor="#FFB86C" IsVisible="False" LineBreakMode="WordWrap"/>
        <Border BackgroundColor="#1B2530" Stroke="#354454" Padding="14"><VerticalStackLayout Spacing="8">
          <Label Text="COMPANION APP" TextColor="#8FA3B5"/>
          <Label x:Name="UpdateStatusLabel" Text="Updates are checked through the paired PC." TextColor="#B9C8D4" LineBreakMode="WordWrap"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><Label Text="Live connection notification" TextColor="#F3F7FA" VerticalTextAlignment="Center"/><Switch Grid.Column="1" x:Name="LiveNotificationSwitch" Toggled="OnLiveNotificationToggled" OnColor="#2BAA78"/></Grid>
          <ProgressBar x:Name="UpdateProgressBar" IsVisible="False" Progress="0" ProgressColor="#2BAA78"/>
          <Button x:Name="UpdateButton" Text="Check for app update" Clicked="OnCheckUpdateClicked" BackgroundColor="#25445E" TextColor="White"/>
        </VerticalStackLayout></Border>
        </VerticalStackLayout>
        <VerticalStackLayout x:Name="SmsContent" IsVisible="False" Spacing="10">
          <Grid ColumnDefinitions="*,Auto"><Label Text="SMS conversations" FontSize="21" FontAttributes="Bold" TextColor="#F3F7FA"/><Button Grid.Column="1" Text="Refresh" Clicked="OnRefreshSmsClicked"/></Grid>
          <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
            <Button x:Name="SmsConversationsButton" Text="Conversations" Clicked="OnSmsConversationsClicked" BackgroundColor="#16875D" TextColor="White"/>
            <Button Grid.Column="1" x:Name="SmsDraftsButton" Text="Drafts" Clicked="OnSmsDraftsClicked" BackgroundColor="#25445E" TextColor="White"/>
            <Button Grid.Column="2" Text="New SMS" Clicked="OnNewSmsClicked" BackgroundColor="#25445E" TextColor="White"/>
          </Grid>
          <CollectionView x:Name="SmsList" SelectionMode="Single" SelectionChanged="OnSmsListSelected" HeightRequest="240">
            <CollectionView.EmptyView><Label Text="No messages in this view." TextColor="#8FA3B5" Padding="10"/></CollectionView.EmptyView>
            <CollectionView.ItemTemplate><DataTemplate><Border BackgroundColor="#1B2530" Stroke="#354454" Padding="10" Margin="0,3"><VerticalStackLayout><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding DisplayAddress}" FontAttributes="Bold" TextColor="#F3F7FA" LineBreakMode="TailTruncation"/><Label Grid.Column="1" Text="{Binding SummaryLabel}" FontAttributes="Bold" TextColor="#63D9A7"/></Grid><Label Text="{Binding Preview}" MaxLines="2" TextColor="#B9C8D4"/><Label Text="{Binding TimeText}" FontSize="11" TextColor="#8FA3B5"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
          </CollectionView>
          <Label x:Name="SmsThreadHeading" Text="Select a conversation" FontAttributes="Bold" TextColor="#F3F7FA" LineBreakMode="TailTruncation"/>
          <CollectionView x:Name="SmsThreadList" SelectionMode="Single" SelectionChanged="OnSmsThreadSelected" HeightRequest="260">
            <CollectionView.EmptyView><Label Text="Select a conversation to view its messages." TextColor="#8FA3B5" Padding="10"/></CollectionView.EmptyView>
            <CollectionView.ItemTemplate><DataTemplate>
              <Border Stroke="#354454" BackgroundColor="#2B3947" Padding="12" Margin="0,4" HorizontalOptions="Start" MaximumWidthRequest="560">
                <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsOutgoing}" Value="True"><Setter Property="HorizontalOptions" Value="End"/><Setter Property="BackgroundColor" Value="#176E9D"/></DataTrigger></Border.Triggers>
                <VerticalStackLayout Spacing="5"><Label Text="{Binding Content}" TextColor="#F3F7FA" LineBreakMode="WordWrap"/><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding FolderLabel}" FontSize="11" TextColor="#B9C8D4"/><Label Grid.Column="1" Text="{Binding TimeText}" FontSize="11" TextColor="#B9C8D4"/></Grid></VerticalStackLayout>
              </Border>
            </DataTemplate></CollectionView.ItemTemplate>
          </CollectionView>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button x:Name="MarkReadSmsButton" Text="Mark read" Clicked="OnMarkReadClicked" IsEnabled="False"/><Button Grid.Column="1" x:Name="DeleteSmsButton" Text="Delete" Clicked="OnDeleteSmsClicked" IsEnabled="False" BackgroundColor="#5A2730" TextColor="White"/></Grid>
          <Entry x:Name="SmsPhoneEntry" Placeholder="Phone number" BackgroundColor="#10171E" TextColor="#F3F7FA"/>
          <Editor x:Name="SmsBodyEntry" Placeholder="Write a message" MinimumHeightRequest="100" BackgroundColor="#10171E" TextColor="#F3F7FA"/>
          <Button x:Name="SendSmsButton" Text="Send SMS" Clicked="OnSendSmsClicked" BackgroundColor="#16875D" TextColor="White"/>
          <Label x:Name="SmsStatusLabel" TextColor="#FFB86C"/>
        </VerticalStackLayout>
        <VerticalStackLayout x:Name="LteContent" IsVisible="False" Spacing="10">
          <Grid ColumnDefinitions="*,Auto"><Label Text="LTE history and cell lock" FontSize="21" FontAttributes="Bold" TextColor="#F3F7FA"/><Button Grid.Column="1" Text="Refresh" Clicked="OnRefreshLteClicked"/></Grid>
          <CollectionView x:Name="LteList" SelectionMode="Single" SelectionChanged="OnLteSelected" HeightRequest="260"><CollectionView.ItemTemplate><DataTemplate><Border BackgroundColor="#1B2530" Stroke="#354454" Padding="10" Margin="0,3"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Label Text="{Binding Band}" FontAttributes="Bold" TextColor="#F3F7FA"/><Label Grid.Column="1" Text="{Binding IdentitySummary}" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" TextColor="#B9C8D4"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
          <Entry x:Name="BandsEntry" Placeholder="PCell band, e.g. 3" BackgroundColor="#10171E" TextColor="#F3F7FA"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Entry x:Name="LockEarfcnEntry" Placeholder="EARFCN" BackgroundColor="#10171E" TextColor="#F3F7FA"/><Entry Grid.Column="1" x:Name="LockPciEntry" Placeholder="PCI" BackgroundColor="#10171E" TextColor="#F3F7FA"/></Grid>
          <Entry x:Name="LockCidEntry" Placeholder="CID (required, decimal or hex)" BackgroundColor="#10171E" TextColor="#F3F7FA"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Apply band lock" Clicked="OnApplyBandLockClicked" BackgroundColor="#25445E" TextColor="White"/><Button Grid.Column="1" Text="Apply PCell lock" Clicked="OnApplyLockClicked" BackgroundColor="#A36A00" TextColor="White"/></Grid>
          <Button Text="Restore automatic" Clicked="OnRestoreAutomaticClicked" BackgroundColor="#16875D" TextColor="White"/>
          <Button Text="Restart router" Clicked="OnRestartRouterClicked" BackgroundColor="#8A3030" TextColor="White"/>
          <Label x:Name="LteStatusLabel" TextColor="#FFB86C"/>
        </VerticalStackLayout>
        <VerticalStackLayout x:Name="DevicesContent" IsVisible="False" Spacing="10">
          <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Connected devices" FontSize="21" FontAttributes="Bold" TextColor="#F3F7FA"/><Label Text="Active clients reported by the TP-Link router" TextColor="#8FA3B5"/></VerticalStackLayout><Button Grid.Column="1" Text="Refresh" Clicked="OnRefreshDevicesClicked"/></Grid>
          <CollectionView x:Name="DevicesList" SelectionMode="None" HeightRequest="460">
            <CollectionView.EmptyView><Label Text="No active devices reported." TextColor="#8FA3B5" Padding="10"/></CollectionView.EmptyView>
            <CollectionView.ItemTemplate><DataTemplate><Border BackgroundColor="#1B2530" Stroke="#354454" Padding="12" Margin="0,3"><VerticalStackLayout Spacing="4"><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding DisplayName}" FontAttributes="Bold" TextColor="#F3F7FA" LineBreakMode="TailTruncation"/><Label Grid.Column="1" Text="{Binding ConnectionType}" TextColor="#63D9A7"/></Grid><Label Text="{Binding AddressSummary}" TextColor="#B9C8D4" LineBreakMode="WordWrap"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
          </CollectionView>
          <Label x:Name="DevicesStatusLabel" TextColor="#FFB86C" LineBreakMode="WordWrap"/>
        </VerticalStackLayout>
        <Button Text="Forget this PC" Clicked="OnForgetClicked" BackgroundColor="#3A2630" TextColor="#FFB4B4"/>
      </VerticalStackLayout>
    </VerticalStackLayout></ScrollView>
  </Grid>
</ContentPage>
