<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NetPulseMonitor</RootNamespace>
    <AssemblyName>NetPulseMonitor</AssemblyName>
    <AssemblyTitle>NetPulse Monitor</AssemblyTitle>
    <Product>NetPulse Monitor</Product>
    <Company>NetPulse Monitor Contributors</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NetPulse.ico</ApplicationIcon>
    <Version>1.0.4</Version>
    <Authors>NetPulse Monitor contributors</Authors>
    <Description>Windows Internet, local-link, LTE router, outage, and speed monitor.</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

</Project>
