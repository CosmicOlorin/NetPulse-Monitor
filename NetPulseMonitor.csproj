<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NetPulseMonitor</RootNamespace>
    <AssemblyName>NetPulse Monitor</AssemblyName>
    <AssemblyTitle>NetPulse Monitor</AssemblyTitle>
    <Product>NetPulse Monitor</Product>
    <Company>CosmicOlorin</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NetPulse.ico</ApplicationIcon>
    <Version>1.0.24</Version>
    <Authors>CosmicOlorin</Authors>
    <Copyright>Copyright © 2026 CosmicOlorin. All rights reserved.</Copyright>
    <Description>Windows Internet, LTE router, outage, SMS, and speed monitor.</Description>
    <RepositoryUrl>https://github.com/CosmicOlorin/NetPulse-Monitor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="mobile\**\*.cs" />
    <AssemblyMetadata Include="Signature" Value="CosmicOlorin 2026 (c)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
